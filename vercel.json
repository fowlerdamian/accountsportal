{
  "functions": {
    "api/cin7-lookup.js":            { "maxDuration": 60 },
    "api/cin7-product.js":           { "maxDuration": 10 },
    "api/sales-sync.js":             { "maxDuration": 10 },
    "api/notify-task-assignee.js":   { "maxDuration": 10 },
    "api/task-reminders.js":         { "maxDuration": 30 },
    "api/finance-snapshot.js":       { "maxDuration": 60 },
    "api/finance-mtd-digest.js":     { "maxDuration": 60 },
    "api/opportunity-sync.js":       { "maxDuration": 10 },
    "api/dialpad-mcp.js":            { "maxDuration": 60 },
    "api/dialpad-sync.js":           { "maxDuration": 60 },
    "api/step-thumbnails.js":        { "maxDuration": 60, "includeFiles": "node_modules/occt-import-js/dist/**" }
  },
  "crons": [
    { "path": "/api/sales-sync-cin7",      "schedule": "0 12 * * 1-5" },
    { "path": "/api/sales-sync-research",  "schedule": "0 13 * * 1-5" },
    { "path": "/api/sales-sync-list",      "schedule": "0 14 * * 1-5" },
    { "path": "/api/task-reminders",       "schedule": "0 22 * * *" },
    { "path": "/api/finance-snapshot",     "schedule": "0 15 * * *" },
    { "path": "/api/finance-mtd-digest",   "schedule": "0 8 * * *" },
    { "path": "/api/opportunity-sync",     "schedule": "45 21 * * *" },
    { "path": "/api/dialpad-sync",         "schedule": "30 19 * * *" }
  ],
  "rewrites": [
    { "source": "/api/sales-sync-cin7",     "destination": "/api/sales-sync?job=cin7" },
    { "source": "/api/sales-sync-research", "destination": "/api/sales-sync?job=research" },
    { "source": "/api/sales-sync-list",     "destination": "/api/sales-sync?job=list" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
